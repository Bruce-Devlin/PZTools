<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <SolidColorBrush x:Key="Brush.BgApp" Color="#11100F"/>
    <SolidColorBrush x:Key="Brush.BgSurface" Color="#191714"/>
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#211E1A"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#332E27"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#51483B"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F2EEE7"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#B4AA9B"/>
    <SolidColorBrush x:Key="Brush.TextInfo" Color="#F1AB62"/>
    <SolidColorBrush x:Key="Brush.TextWarn" Color="#E9BC67"/>
    <SolidColorBrush x:Key="Brush.TextDanger" Color="#F08078"/>
    <SolidColorBrush x:Key="Brush.TextSuccess" Color="#7CCB91"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#21160C"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#E9852D"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F39A49"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#C96A21"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#F0A257"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#6D3D1E"/>

    <!-- Control surfaces -->
    <SolidColorBrush x:Key="Brush.BgControl" Color="#211E1A"/>
    <SolidColorBrush x:Key="Brush.BgControlHover" Color="#302A23"/>
    <SolidColorBrush x:Key="Brush.BgControlPressed" Color="#3A3026"/>
    <SolidColorBrush x:Key="Brush.BgDanger" Color="#3A211F"/>
</ResourceDictionary>
