<Window x:Class="PZTools.Core.Windows.Dialogs.AboutApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PZTools.Core.Windows.Dialogs"
        mc:Ignorable="d"
        Title="About PZ Tools"
        Height="545"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.BgApp}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Icon="/Core/Assets/Icons/PZToolsIcon.png">

    <Grid Margin="18">
        <Border Style="{DynamicResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource Brush.BgControl}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="4">
                        <Image Source="/Core/Assets/Icons/PZToolsIcon.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PZ Tools" Style="{DynamicResource Text.Display}"/>
                        <TextBlock Text="Project Zomboid Modding Toolkit" Style="{DynamicResource Text.Muted}" FontSize="14" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Margin="0,0,8,0">

                    <TextBlock Text="Version"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontWeight="Bold"/>

                    <TextBlock Text="1.0.0"
                               Foreground="{DynamicResource Brush.TextInfo}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Description"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontWeight="Bold"/>

                    <TextBlock Text="PZ Tools is a lightweight development environment designed to simplify Project Zomboid project creation, testing, and file management."
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Built by a Project Zomboid modder, PZ Tools brings the game-specific workflows that traditional IDEs lack into one approachable workspace."
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Developer"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontWeight="Bold"/>

                    <TextBlock Text="Bruce Devlin"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Tech Stack"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontWeight="Bold"/>

                    <TextBlock Text="C# • WPF • AvalonEdit • Lua/MoonSharp • .NET"
                               Foreground="{DynamicResource Brush.TextPrimary}" 
                               Margin="0,0,0,12"/>

                    <TextBlock Text="The Legal Bit"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontWeight="Bold"/>
                    
                    <TextBlock Text="This application is an independent, unofficial, third-party fan project and is not affiliated with, endorsed by, or sponsored by The Indie Stone. Project Zomboid, The Indie Stone, and all related names, logos, assets, and trademarks are the property of their respective owners. All rights are reserved. Any references to Project Zomboid or related content are used solely for identification and compatibility purposes. No ownership or association is claimed or implied. This project will always be free and open source."
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Border}"
                        Height="1"
                        VerticalAlignment="Top"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">

                    <Button Content="GitHub"
                            Width="110"
                            Margin="0,0,10,0"
                            Style="{DynamicResource ModernButton}"
                            Click="GitHub_Click"/>

                    <Button Content="Close"
                            Width="110"
                            Style="{DynamicResource PrimaryButton}"
                            IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
