<Window x:Class="PZTools.Core.Windows.Dialogs.GameKnowledgeExplorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Code Knowledge Base - PZ Tools" Width="1180" Height="760"
        MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        Icon="/Core/Assets/Icons/PZToolsIcon.png">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Game code knowledge base" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Search the types and members recovered from Project Zomboid's Java code. Results link back to the exact decompiled source."
                           Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="12" Padding="13,6" Background="{DynamicResource Brush.BgElevated}" VerticalAlignment="Center">
                <TextBlock x:Name="IndexSummaryText" Text="Loading index..." Foreground="{DynamicResource Brush.TextMuted}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="BuildCombo" Style="{DynamicResource ModernComboBox}" DisplayMemberPath="Name"
                      SelectionChanged="BuildCombo_SelectionChanged" ToolTip="Decompiled game build"/>
            <ComboBox x:Name="KindCombo" Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource ModernComboBox}"
                      SelectionChanged="KindCombo_SelectionChanged">
                <ComboBoxItem Content="All symbols" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="Types" Tag="Type"/>
                <ComboBoxItem Content="Methods" Tag="Method"/>
                <ComboBoxItem Content="Constructors" Tag="Constructor"/>
                <ComboBoxItem Content="Fields" Tag="Field"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource ModernTextBox}"
                     TextChanged="SearchBox_TextChanged" ToolTip="Search names, signatures, packages, parameters, and documentation"/>
            <Button Grid.Column="3" Content="Rebuild index" Style="{StaticResource ToolbarButton}" Click="Rebuild_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Background="{DynamicResource Brush.BgControl}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <TextBlock Text="KIND" Margin="12,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="SYMBOL" Margin="8,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Grid.Column="2" Text="SOURCE" Margin="8,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Grid>
                    <ListView x:Name="ResultsList" Grid.Row="1" BorderThickness="0" Background="{DynamicResource Brush.BgSurface}"
                              SelectionChanged="ResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextInfo}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="{Binding QualifiedName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Signature}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Location}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="{DynamicResource Brush.BgApp}" Opacity="0.95">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="240" Height="5" IsIndeterminate="True" Style="{StaticResource ModernProgressBar}"/>
                            <TextBlock x:Name="BusyText" Text="Loading game-code index..." HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DetailNameText" Text="Select a symbol" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox x:Name="SignatureText" Grid.Row="1" Margin="0,12,0,0" Padding="10" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" Style="{DynamicResource ModernTextBox}" Text="Choose a result to inspect its declaration."/>
                    <TextBlock x:Name="DetailLocationText" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Decompiler notes" Style="{DynamicResource Text.Label}"/>
                            <TextBlock x:Name="DocumentationText" Margin="0,6,0,14" TextWrapping="Wrap" Text="No symbol selected."/>
                            <TextBlock Text="Mod-development guidance" Style="{DynamicResource Text.Label}"/>
                            <TextBlock x:Name="GuidanceText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="Search for a game type or member to inspect its recovered Java declaration."/>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Right">
                        <Button x:Name="CopyButton" Content="Copy signature" Style="{StaticResource ToolbarButton}" Click="Copy_Click" IsEnabled="False"/>
                        <Button x:Name="OpenButton" Content="Open source at line" Style="{StaticResource ToolbarButton}" Click="Open_Click" IsEnabled="False"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Width="110" Style="{DynamicResource ModernButton}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
