<Window x:Class="PZTools.Core.Windows.Dialogs.AppKnowledgeExplorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to use - PZ Tools" Width="1120" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Icon="/Core/Assets/Icons/PZToolsIcon.png"
        Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PZ Tools knowledgebase" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="How to use the app, from your first project to everyday workflows. Available offline."
                       TextWrapping="Wrap" Margin="0,5,0,14" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" ToolTip="Alt+Left" Style="{DynamicResource CompactButton}"/>
            <Button x:Name="ForwardButton" Content="Forward" Click="Forward_Click" ToolTip="Alt+Right" Margin="6,0" Style="{DynamicResource CompactButton}"/>
            <Button Content="Home" Click="Home_Click" Style="{DynamicResource CompactButton}"/>
            <Button Content="A−" Click="Smaller_Click" AutomationProperties.Name="Decrease article text size" Margin="18,0,6,0" Style="{DynamicResource CompactButton}"/>
            <Button Content="A+" Click="Larger_Click" AutomationProperties.Name="Increase article text size" Style="{DynamicResource CompactButton}"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="220"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="Search all articles" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,5"/>
                    <TextBox x:Name="SearchBox" TextChanged="Filters_Changed" ToolTip="Search titles and article text (Ctrl+F). All words must match." AutomationProperties.Name="Search knowledgebase" Style="{DynamicResource ModernTextBox}"/>
                </StackPanel>
                <ComboBox x:Name="CategoryBox" Grid.Row="1" Margin="0,10,0,0" SelectionChanged="Filters_Changed" AutomationProperties.Name="Article category" Style="{DynamicResource ModernComboBox}"/>
                <TextBlock x:Name="ResultCount" Grid.Row="2" TextWrapping="Wrap" Margin="0,10,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>
                <ListBox x:Name="ArticleList" Grid.Row="3" SelectionChanged="ArticleList_SelectionChanged"
                         Background="{DynamicResource Brush.BgSurface}" Foreground="{DynamicResource Brush.TextPrimary}"
                         BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Knowledgebase articles">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Category}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource Brush.Border}"/>
            <Border Grid.Column="2" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <FlowDocumentScrollViewer x:Name="ArticleReader" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Help article"/>
            </Border>
        </Grid>
    </Grid>
</Window>
