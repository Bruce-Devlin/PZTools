<Window x:Class="PZTools.Core.Windows.Dialogs.Project.RunProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PZ Tools Playtest Lab" Height="820" Width="1120" MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        Icon="/Core/Assets/Icons/PZToolsIcon.png" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Playtest Lab" Style="{StaticResource Text.Title}" FontSize="24"/><TextBlock Text="Repeatable, isolated single-player and dedicated-server testing" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="cmbProfiles" Width="230" Style="{StaticResource ModernComboBox}" SelectionChanged="Profile_SelectionChanged"/>
                <Button Content="New" Width="72" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="NewProfile_Click"/>
                <Button Content="Delete" Width="72" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="DeleteProfile_Click"/>
                <Button Content="Save profile" Width="105" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.Border}">
            <TabItem Header="PROFILE"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Profile name" VerticalAlignment="Center"/><TextBox x:Name="txtProfileName" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,4,18,4"/>
                <TextBlock Grid.Column="2" Text="Mode" VerticalAlignment="Center"/><ComboBox x:Name="cmbMode" Grid.Column="3" Style="{StaticResource ModernComboBox}" Margin="0,4" SelectionChanged="Mode_SelectionChanged"/>
                <TextBlock Grid.Row="1" Text="Game build" VerticalAlignment="Center"/><ComboBox x:Name="cmbBuilds" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="0,4,18,4" SelectionChanged="Build_SelectionChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Launch arguments" VerticalAlignment="Center"/><TextBox x:Name="txtLaunchArgs" Grid.Row="1" Grid.Column="3" Style="{StaticResource ModernTextBox}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Save mode" VerticalAlignment="Center"/><ComboBox x:Name="cmbSaveMode" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="0,4,18,4" SelectionChanged="SaveMode_SelectionChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Source save folder" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="txtSourceSave" Style="{StaticResource ModernTextBox}" Margin="0,4,8,4"/><Button Grid.Column="1" Content="Browse" Width="75" Style="{StaticResource ModernButton}" Click="BrowseSave_Click"/></Grid>
                <TextBlock Grid.Row="3" Text="Game display" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbWindowMode" Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="0,4,18,4"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Window size" VerticalAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="txtWindowWidth" Style="{StaticResource ModernTextBox}" Margin="0,4,8,4"/><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="txtWindowHeight" Grid.Column="2" Style="{StaticResource ModernTextBox}" Margin="0,4"/></Grid>
                <CheckBox x:Name="chkKeepSession" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Content="Keep isolated session data after the test finishes" Style="{StaticResource ModernCheckBox}" Margin="0,10,0,4"/>
                <Border Grid.Row="5" Grid.ColumnSpan="4" Style="{StaticResource InsetCard}" Margin="0,14,0,0"><TextBlock Text="Playtests default to a predictable 1280 × 720 window. Fresh Clone copies the selected save. Empty starts clean. Reuse keeps the profile's isolated world." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/></Border>
            </Grid></ScrollViewer></TabItem>
            <TabItem Header="DEPENDENCIES &amp; LOAD ORDER"><Grid Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Required project dependencies are kept in sync. Add optional compatibility-test mods and arrange their preferred order here." Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbDiscoveredDependencies" DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBox}"/>
                    <Button Grid.Column="1" Content="Add installed" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Padding="14,7" Click="AddDiscoveredDependency_Click"/>
                    <Button Grid.Column="2" Content="Sync required" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Padding="14,7" Click="SyncRequiredDependencies_Click"/>
                </Grid>
                <DataGrid x:Name="DependencyGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                        <DataGridCheckBoxColumn Header="REQUIRED" Binding="{Binding IsProjectRequired}" IsReadOnly="True" Width="78"/>
                        <DataGridTextColumn Header="MOD ID" Binding="{Binding ModId, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        <DataGridTextColumn Header="WORKSHOP ID" Binding="{Binding WorkshopId, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
                        <DataGridTextColumn Header="LOCAL SOURCE" Binding="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Local sources are validated and copied into isolated caches. Workshop IDs are emitted for Steam-enabled servers. Explicit mod.info before/after rules are applied to generated lists."
                               Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Browse source" Style="{StaticResource ModernButton}" Padding="12,7" Click="BrowseDependencySource_Click"/>
                        <Button Content="Up" Style="{StaticResource ModernButton}" Width="55" Margin="6,0,0,0" Click="MoveDependencyUp_Click"/>
                        <Button Content="Down" Style="{StaticResource ModernButton}" Width="58" Margin="6,0,0,0" Click="MoveDependencyDown_Click"/>
                        <Button Content="Remove" Style="{StaticResource ModernButton}" Width="72" Margin="6,0,0,0" Click="RemoveDependency_Click"/>
                    </StackPanel>
                </Grid>
            </Grid></TabItem>
            <TabItem Header="DEDICATED SERVER"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid x:Name="ServerPanel" Margin="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                <TextBlock Text="Server install/launcher" VerticalAlignment="Center"/><Grid Grid.Column="1" Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="txtServerInstall" Style="{StaticResource ModernTextBox}" Margin="0,4,8,4"/><Button Grid.Column="1" Content="Browse" Width="75" Style="{StaticResource ModernButton}" Click="BrowseServer_Click"/></Grid>
                <TextBlock Grid.Row="1" Text="Server name" VerticalAlignment="Center"/><TextBox x:Name="txtServerName" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,4,18,4"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Port" VerticalAlignment="Center"/><TextBox x:Name="txtServerPort" Grid.Row="1" Grid.Column="3" Style="{StaticResource ModernTextBox}" Margin="0,4"/>
                <TextBlock Grid.Row="2" Text="Maximum players" VerticalAlignment="Center"/><TextBox x:Name="txtMaxPlayers" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,4,18,4"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Local clients" VerticalAlignment="Center"/><TextBox x:Name="txtClientCount" Grid.Row="2" Grid.Column="3" Style="{StaticResource ModernTextBox}" Margin="0,4"/>
                <TextBlock Grid.Row="3" Text="Startup timeout (seconds)" VerticalAlignment="Center"/><TextBox x:Name="txtServerTimeout" Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBox}" Margin="0,4,18,4"/><StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"><CheckBox x:Name="chkNoSteam" Content="No-Steam local test" Style="{StaticResource ModernCheckBox}" Margin="0,8,18,0"/><CheckBox x:Name="chkAutoConnect" Content="Auto-connect clients" Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"/></StackPanel>
                <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="Additional non-secret server options (Key=Value, one per line)" Margin="0,12,0,5"/>
                <TextBox x:Name="txtServerOptions" Grid.Row="5" Grid.ColumnSpan="4" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid></ScrollViewer></TabItem>
        </TabControl>
        <Border Grid.Row="2" Style="{StaticResource InsetCard}" Margin="0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SESSION OUTPUT" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/><TextBox x:Name="txtOutputLog" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="{DynamicResource Brush.TextInfo}" FontFamily="Consolas" BorderThickness="0" Margin="0,8,0,0"/></Grid></Border>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Brush.TextMuted}"/><CheckBox x:Name="chkShowEveryRun" Content="Show this each time I press Run Game" IsChecked="False" Margin="0,7,0,0" Checked="ShowEveryRun_Changed" Unchecked="ShowEveryRun_Changed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Close" Width="105" Margin="0,0,8,0" Style="{StaticResource ModernButton}" IsCancel="True" Click="BtnClose_Click"/><Button x:Name="btnStopGame" Content="Stop session" Width="120" Margin="0,0,8,0" Style="{StaticResource ModernButton}" Click="btnStopGame_Click" IsEnabled="False"/><Button x:Name="btnLaunch" Content="Run profile" Width="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnLaunch_Click"/></StackPanel></Grid>
    </Grid>
</Window>
