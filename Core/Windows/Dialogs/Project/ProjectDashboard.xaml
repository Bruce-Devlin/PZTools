<Window x:Class="PZTools.Core.Windows.Dialogs.Project.ProjectDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Health - PZ Tools" Width="1040" Height="700" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgApp}"
        Foreground="{DynamicResource Brush.TextPrimary}" Icon="/Core/Assets/Icons/PZToolsIcon.png">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BgElevated}"/>
        </Style>
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="ProjectTitle" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProjectPathText" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="ReadinessBadge" CornerRadius="12" Padding="13,6" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                <TextBlock x:Name="ReadinessText" Text="Checking..." FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextOnAccent}"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="BUILD TARGETS" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock x:Name="TargetCountText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="LUA FILES" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock x:Name="LuaCountText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ZEDSCRIPTS" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock x:Name="ScriptCountText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CONTENT SIZE" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock x:Name="ContentSizeText" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel>
                <Button Style="{StaticResource SmallAction}" Content="Refresh health" Click="Refresh_Click"/>
                <Button Style="{StaticResource SmallAction}" Content="Set up VS Code" Click="SetupVsCode_Click"/>
                <Button Style="{StaticResource SmallAction}" Content="Open in VS Code" Click="OpenVsCode_Click"/>
                <Button Style="{StaticResource SmallAction}" Content="Project settings" Click="ProjectSettings_Click"/>
                <Button Style="{StaticResource SmallAction}" Content="Game log" Click="GameLog_Click"/>
                <Button x:Name="ExportReportButton" Style="{StaticResource SmallAction}" Content="Export report" Click="ExportReport_Click" IsEnabled="False"/>
            </WrapPanel>
            <CheckBox x:Name="ValidateLuaCheck" Grid.Row="1" Content="Validate every Lua file during health checks" IsChecked="True" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Background="{DynamicResource Brush.BgControl}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="LEVEL" Margin="12,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="CODE" Margin="8,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Grid.Column="2" Text="LOCATION" Margin="8,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Grid.Column="3" Text="PROBLEM" Margin="8,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>
                <ListView x:Name="DiagnosticsList" Grid.Row="1" BorderThickness="0" Background="{DynamicResource Brush.BgSurface}" SelectionChanged="DiagnosticsList_SelectionChanged" MouseDoubleClick="DiagnosticsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SeverityIcon}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.TextWarn}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Code}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,9">
                    <TextBlock x:Name="RecommendationText" Text="Select a problem for details. Double-click to open its file." Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="{DynamicResource Brush.BgApp}" Opacity="0.94" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar Width="240" Height="5" IsIndeterminate="True" Style="{StaticResource ModernProgressBar}"/><TextBlock x:Name="BusyText" Text="Checking project..." HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LastCheckedText" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SmallAction}" Content="Open project folder" Click="OpenFolder_Click"/>
                <Button Style="{StaticResource ModernButton}" Width="110" Content="Close" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
