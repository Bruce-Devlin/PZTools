<Window x:Class="PZTools.Core.Windows.Dialogs.Project.NewModFile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New PZ Mod File" Width="580" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgApp}"
        Foreground="{DynamicResource Brush.TextPrimary}" Icon="/Core/Assets/Icons/PZToolsIcon.png">
    <Grid Margin="18">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Create a Project Zomboid file" Style="{StaticResource Text.Title}"/>
                <TextBlock Grid.Row="1" Text="Choose a target, file type, and name." Style="{StaticResource Text.Muted}" Margin="0,2,0,16"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Build target" VerticalAlignment="Center"/><ComboBox x:Name="TargetCombo" Grid.Column="1" Style="{StaticResource ModernComboBox}" DisplayMemberPath="BuildName"/>
                    <TextBlock Grid.Row="1" Text="File type" VerticalAlignment="Center" Margin="0,12,0,0"/><ComboBox x:Name="TemplateCombo" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernComboBox}" SelectionChanged="TemplateCombo_SelectionChanged"/>
                    <TextBlock Grid.Row="2" Text="File name" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Style="{StaticResource ModernTextBox}"/>
                </Grid>
                <Border Grid.Row="3" Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Brush.BgApp}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel><TextBlock x:Name="DestinationText" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextInfo}"/><TextBlock x:Name="TemplateDescription" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource Brush.TextMuted}"/></StackPanel>
                </Border>
                <CheckBox x:Name="OpenAfterCreateCheck" Grid.Row="4" Content="Open the new file in VS Code" IsChecked="True" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Bottom" Margin="0,16,0,0"/>
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" Width="100" Style="{StaticResource ModernButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Create file" Width="110" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Create_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
