<Window x:Class="PZTools.Core.Windows.Dialogs.Project.TestExplorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Test Explorer" Width="1040" Height="740" MinWidth="800" MinHeight="600"
        Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Mod tests" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Run Lua unit tests or automate an isolated game session. Select a file to run it; leave the selection empty to run all matching files." TextWrapping="Wrap" Margin="0,6,0,10"/>
            <WrapPanel>
                <Button Content="Create test examples" Click="Scaffold_Click" Margin="0,0,8,8"/>
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,8"/>
                <Button Content="Edit selected file" Click="Edit_Click" Margin="0,0,8,8"/>
                <Button Content="Playtest profiles" Click="Profiles_Click" Margin="0,0,8,8"/>
                <Button Content="Clear selection" Click="Clear_Click" Margin="0,0,8,8"/>
            </WrapPanel>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="Profiles" Width="180" DisplayMemberPath="Name" Margin="0,0,8,8" ToolTip="Saved Playtest Lab profile"/>
            <TextBox x:Name="Filter" Width="140" Margin="0,0,8,8" ToolTip="Filter test file names"/>
            <Button x:Name="Unit" Content="Run unit tests" Click="Unit_Click" Margin="0,0,8,8"/>
            <Button x:Name="Game" Content="Run game tests" Click="Game_Click" Margin="0,0,8,8"/>
            <Button x:Name="Stop" Content="Cancel run" IsEnabled="False" Click="Stop_Click" Margin="0,0,8,8"/>
            <Button x:Name="Artifacts" Content="Open report folder" IsEnabled="False" Click="Artifacts_Click" Margin="0,0,8,8"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Files" DisplayMemberPath="Display"/>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <DataGrid Grid.Column="2" x:Name="Results" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="Result_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Test" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="90"/>
                    <DataGridTextColumn Header="Seconds" Binding="{Binding DurationSeconds, StringFormat=F2}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <TextBox Grid.Row="3" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10"/>
        <TextBlock Grid.Row="4" x:Name="Status" Text="Ready. Unit tests run without the game. Game tests require a configured playtest profile." TextWrapping="Wrap"/>
    </Grid>
</Window>
