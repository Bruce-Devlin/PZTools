<Window x:Class="PZTools.Core.Windows.Dialogs.Project.ProjectSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PZTools — Open a project" Height="620" Width="820" MinHeight="510" MinWidth="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        Icon="/Core/Assets/Icons/PZToolsIcon.png">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PZTOOLS" Foreground="{DynamicResource Brush.Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Your next mod starts here." Style="{DynamicResource Text.Display}"/>
                <TextBlock Text="Open a workspace, create a mod, or bring an existing project." Style="{DynamicResource Text.Muted}" Margin="0,9,20,0"/>
            </StackPanel>
            <Image Grid.Column="1" Source="/Core/Assets/PZTools.png" Width="96" Height="96"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FIND A PROJECT" Style="{DynamicResource Text.Label}" FontSize="10" Margin="0,0,0,6"/>
                <TextBox x:Name="ProjectFilter" Style="{DynamicResource ModernTextBox}" TextChanged="ProjectFilter_TextChanged"
                         ToolTip="Filter projects by name or location" AutomationProperties.Name="Filter projects"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="ProjectCount" Style="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>
        <Border Grid.Row="2" Style="{DynamicResource InsetCard}" Padding="8">
            <Grid>
                <TreeView x:Name="ProjectsTreeView" Style="{DynamicResource ModernTreeView}" BorderThickness="0"
                          MouseDoubleClick="ProjectsTreeView_DoubleClick">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}">
                            <Setter Property="MinHeight" Value="42"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Targets}">
                            <StackPanel Margin="4,5" ToolTip="{Binding RootPath}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding RootPath}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BuildName}" Foreground="{DynamicResource Brush.TextInfo}" Margin="4,3" ToolTip="{Binding Path}"/>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel x:Name="NoProjectsState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="NoProjectsTitle" Text="No projects yet" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="NoProjectsBody" Text="Create a new project or import an existing mod below." Style="{DynamicResource Text.Muted}" Margin="0,8,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,14,0,18">
            <Button x:Name="OpenProjectFolderBtn" DockPanel.Dock="Right" Content="Open folder" Style="{DynamicResource CompactButton}" Margin="12,0,0,0" Click="OpenProjectFolderBtn_Click"/>
            <StackPanel>
                <TextBlock Text="WORKSPACE LOCATION" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock x:Name="ProjectFolderTxt" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="New project" Style="{DynamicResource ModernButton}" Click="NewProjectButton_Click"/>
                <Button Content="Import mod" Style="{DynamicResource ModernButton}" Margin="8,0,0,0" Click="ImportModButton_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Exit" Style="{DynamicResource ModernButton}" IsCancel="True" Click="CancelButton_Click" Margin="0,0,8,0"/>
                <Button x:Name="OpenProjectButton" Content="Open project" Style="{DynamicResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
