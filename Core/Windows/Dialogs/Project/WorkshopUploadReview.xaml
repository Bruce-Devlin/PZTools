<Window x:Class="PZTools.Core.Windows.Dialogs.Project.WorkshopUploadReview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Steam Workshop Upload" Width="680" Height="650" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        Icon="/Core/Assets/Icons/PZToolsIcon.png">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Review Workshop upload" Style="{StaticResource Text.Title}" FontSize="24"/>
            <TextBlock Text="Nothing is sent until you confirm and complete SteamCMD authentication." Style="{StaticResource Text.Muted}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="ACTION" Style="{StaticResource Text.Label}"/><TextBlock x:Name="ActionText" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="ITEM ID" Style="{StaticResource Text.Label}" Margin="0,9,0,0"/><TextBlock x:Name="ItemIdText" Grid.Row="1" Grid.Column="1" Margin="0,9,0,0"/>
                        <TextBlock Grid.Row="2" Text="VISIBILITY" Style="{StaticResource Text.Label}" Margin="0,9,0,0"/><TextBlock x:Name="VisibilityText" Grid.Row="2" Grid.Column="1" Margin="0,9,0,0"/>
                        <TextBlock Grid.Row="3" Text="TAGS" Style="{StaticResource Text.Label}" Margin="0,9,0,0"/><TextBlock x:Name="TagsText" Grid.Row="3" Grid.Column="1" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Text="PREVIEW" Style="{StaticResource Text.Label}" Margin="0,9,0,0"/><TextBlock x:Name="PreviewText" Grid.Row="4" Grid.Column="1" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <TextBlock Text="Workshop title" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="TitleText" IsReadOnly="True" Margin="0,6,0,12"/>
                <TextBlock Text="Workshop description" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="DescriptionText" IsReadOnly="True" Height="125" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,12"/>
                <TextBlock Text="Change note for this upload" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="ChangeNoteText" Margin="0,6,0,12"/>
                <Border Style="{StaticResource InsetCard}">
                    <TextBlock TextWrapping="Wrap">By submitting this item, you agree to the <Hyperlink NavigateUri="https://steamcommunity.com/sharedfiles/workshoplegalagreement" RequestNavigate="LegalAgreement_RequestNavigate">Steam Workshop terms of service</Hyperlink>. SteamCMD will open in its own window for your password and Steam Guard code. PZTools does not receive or store either.</TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="110" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Confirm and continue" MinWidth="175" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
