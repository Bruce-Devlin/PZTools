<Window x:Class="PZTools.Core.Windows.Dialogs.GameKnowledgeTree"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game code tree - PZ Tools" Width="1440" Height="900" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.BgApp}"
        Foreground="{DynamicResource Brush.TextPrimary}" Icon="/PZTools;component/Core/Assets/Icons/PZToolsIcon.png">
    <Window.Resources>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource ModernTreeViewItem}"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Game code · Visual tree" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Expand packages, classes and methods to explore their members and variables. Click a connected node to follow it."
                       Margin="0,6" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBlock Text="Calls are inferred from decompiled source. Possible overloads and unresolved calls are labelled; runtime dispatch and reflection are not resolved."
                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="650"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="FilterBox" Style="{DynamicResource ModernTextBox}" TextChanged="Filter_Changed" ToolTip="Filter classes and members by name or signature"/>
                <TextBlock Text="All indexed classes and visibility levels · filter by name" Grid.Row="1" Margin="0,7" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                <TreeView x:Name="ClassTree" Grid.Row="2" SelectedItemChanged="Tree_Selected" Background="{DynamicResource Brush.BgSurface}"
                          Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource Brush.Border}"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="8"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="1.5" Value="1" Width="80" VerticalAlignment="Center" ToolTip="Relationship map zoom"/>
                    </StackPanel>
                    <Button x:Name="BackButton" DockPanel.Dock="Left" Content="← Back" Click="Back_Click" Style="{DynamicResource CompactButton}" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="OwnerButton" DockPanel.Dock="Left" Content="Containing object ↑" Click="Owner_Click" Style="{DynamicResource CompactButton}" IsEnabled="False" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FocusTitle" Text="Select a class or member" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Background="{DynamicResource Brush.BgSurface}">
                    <Canvas x:Name="Map" Width="860" Height="260">
                        <Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}"/></Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,7">
                        <Button x:Name="OpenButton" Content="Open source at line" DockPanel.Dock="Right" Click="Open_Click" Style="{DynamicResource CompactButton}" IsEnabled="False"/>
                        <TextBlock x:Name="SourceLocation" Text="Full declaration / implementation" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBox x:Name="SourceText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Background="{DynamicResource Brush.BgControl}" Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="Top" HorizontalContentAlignment="Left"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LoadStateText" Text="Preparing indexed classes..." Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
            <ProgressBar x:Name="LoadProgress" Height="4" Margin="0,6" Minimum="0" Maximum="1" Value="0" Style="{StaticResource ModernProgressBar}"/>
            <TextBlock x:Name="StatusText" Text="Preparing tree..." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>
    </Grid>
</Window>
