<Window x:Class="PZTools.Core.Windows.Dialogs.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette" Width="650" Height="460" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.BgApp}" Foreground="{DynamicResource Brush.TextPrimary}"
        PreviewKeyDown="Palette_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Command Palette" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="Query" Grid.Row="1" Style="{DynamicResource ModernTextBox}"
                 AutomationProperties.Name="Find a command" ToolTip="Search commands by name or menu, such as test, health, or Workshop"
                 TextChanged="Query_Changed" Margin="0,0,0,12"/>
        <ListBox x:Name="Results" Grid.Row="2" Background="{DynamicResource Brush.BgSurface}"
                 Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Results_DoubleClick"
                 AutomationProperties.Name="Matching commands">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Margin="10,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Hint" Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                   Text="↑ ↓ to select · Enter to run · Esc to close"/>
    </Grid>
</Window>
