<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>PZTools</AssemblyName>
    <RootNamespace>PZTools</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <Title>PZTools</Title>
    <ApplicationIcon>Core\Assets\Icons\PZToolsIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="PZTools.Mcp\**\*.cs" />
    <None Remove="Core\Assets\PZTools.png" />
    <None Remove="Core\Assets\PZToolsIcon.ico" />
    <None Remove="Resources\PZLua.xshd" />
  </ItemGroup>

  <!-- MCP runs as a separate process, so build/package it independently with the
       editor's deployment settings instead of referencing its executable. -->
  <Target Name="CopyMcpServer" AfterTargets="Build">
    <MSBuild Projects="PZTools.Mcp\PZTools.Mcp.csproj" Targets="Restore;Build"
             RemoveProperties="PublishProfile;PublishProfileFullPath"
             Properties="Configuration=$(Configuration);PublishProfile=;SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier);PublishSingleFile=false" />
    <MSBuild Projects="PZTools.Mcp\PZTools.Mcp.csproj" Targets="GetTargetPath"
             RemoveProperties="PublishProfile;PublishProfileFullPath"
             Properties="Configuration=$(Configuration);PublishProfile=;SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier);PublishSingleFile=false">
      <Output TaskParameter="TargetOutputs" ItemName="_McpTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_McpBuildDir>@(_McpTargetPath->'%(RootDir)%(Directory)')</_McpBuildDir>
    </PropertyGroup>
    <ItemGroup>
      <_McpServerFiles Include="$(_McpBuildDir)*" />
      <_McpServerFiles Include="$(_McpBuildDir)runtimes\**\*">
        <CompanionSubdirectory>runtimes\</CompanionSubdirectory>
      </_McpServerFiles>
    </ItemGroup>
    <Copy SourceFiles="@(_McpServerFiles)"
          DestinationFiles="@(_McpServerFiles->'$(OutDir)mcp\%(CompanionSubdirectory)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMcpServerToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_McpPublishDir>$(MSBuildProjectDirectory)\PZTools.Mcp\obj\companion-publish\$(Configuration)\$(RuntimeIdentifier)\$(SelfContained)\$(PublishSingleFile)\</_McpPublishDir>
    </PropertyGroup>
    <MSBuild Projects="PZTools.Mcp\PZTools.Mcp.csproj" Targets="Publish"
             RemoveProperties="PublishProfile;PublishProfileFullPath;PublishUrl"
             Properties="Configuration=$(Configuration);PublishProfile=;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);PublishDir=$(_McpPublishDir);NoBuild=false" />
    <ItemGroup>
      <_McpPublishFiles Include="$(_McpPublishDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_McpPublishFiles)"
          DestinationFiles="@(_McpPublishFiles->'$(PublishDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="Core\Assets\Icons\PZToolsIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Core\Assets\UI\Preloader.png" />
    <Resource Include="Core\Assets\Icons\PZToolsIcon.ico" />
    <Resource Include="Core\Assets\Icons\PZToolsIcon.png" />
    <Resource Include="Core\Assets\PZTools.png" />
    <EmbeddedResource Include="Resources\PZinfo.xshd" />
    <EmbeddedResource Include="Resources\PZtxt.xshd" />
    <EmbeddedResource Include="Resources\PZlua.xshd" />
    <EmbeddedResource Include="Resources\Testing\*.lua" />
  </ItemGroup>

</Project>
