<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/Functions/Help/AppKnowledgeBase.cs" Link="AppKnowledgeBase.cs" />
    <Compile Include="../../Core/Windows/Dialogs/AppKnowledgeExplorer.xaml.cs" Link="AppKnowledgeExplorer.xaml.cs" />
    <Page Include="../../Core/Windows/Dialogs/AppKnowledgeExplorer.xaml" Link="AppKnowledgeExplorer.xaml" />
    <Page Include="../../Core/Windows/Themes/*.xaml" Link="Themes/%(Filename)%(Extension)" />
    <Page Include="../../Core/Windows/Styles/AppStyles.xaml" Link="Styles/AppStyles.xaml" />
    <EmbeddedResource Include="../../Resources/Help/KnowledgeBase.md" LogicalName="PZTools.Resources.Help.KnowledgeBase.md" />
    <Resource Include="../../Core/Assets/Icons/PZToolsIcon.png" Link="Core/Assets/Icons/PZToolsIcon.png" />
  </ItemGroup>
</Project>
